# ============================================================================
# UNIFIED INTELLIGENT AGENT - Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your values

# ============================================================================
# LLM CONFIGURATION
# ============================================================================

# Groq API (Primary LLM)
GROQ_API_KEY=your_groq_api_key_here

# Ollama Configuration (Fallback LLM - Optional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# ============================================================================
# DATABASE & STORAGE
# ============================================================================

# Vector Store
FAISS_INDEX_PATH=./data/indices/faiss
BM25_INDEX_PATH=./data/indices/bm25

# Cache
CACHE_ENABLED=true
CACHE_BACKEND=disk  # or redis

# ============================================================================
# PROCESSING
# ============================================================================

# Embedding Model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu  # or cuda

# Whisper (for transcription)
WHISPER_MODEL=small  # tiny, base, small, medium, large

# ============================================================================
# LOGGING
# ============================================================================

LOG_LEVEL=INFO
DEBUG=false
VERBOSE=false

# ============================================================================
# API CONFIGURATION
# ============================================================================

API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# ============================================================================
# OPTIONAL: ADVANCED SETTINGS
# ============================================================================

# Retrieval Parameters
RETRIEVAL_TOP_K=8
RETRIEVAL_SIMILARITY_THRESHOLD=0.3

# LLM Parameters
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024

# Deduplication
DEDUP_THRESHOLD=0.85

# ============================================================================
# NOTES
# ============================================================================

# Get GROQ_API_KEY from: https://console.groq.com
# Make sure Ollama is running if using fallback LLM
# For CUDA support, set EMBEDDING_DEVICE=cuda (requires GPU)
# Tesseract OCR path may need to be configured for Windows
